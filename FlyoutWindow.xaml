<Window x:Class="GammaTool.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GammaTool" Width="284" Height="156"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True">

    <Border Margin="12" CornerRadius="12" Background="#1E1F24"
            BorderBrush="#363840" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>

        <Grid Margin="16,14,16,14"
              TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
              TextElement.Foreground="#F2F2F4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок и значение -->
            <DockPanel>
                <TextBlock x:Name="ValueText" DockPanel.Dock="Right" Text="0%"
                           FontSize="14" FontWeight="SemiBold" Foreground="#E8590C"/>
                <TextBlock Text="Гамма" FontSize="14" FontWeight="SemiBold"/>
            </DockPanel>

            <!-- Ползунок -->
            <Slider x:Name="IntensitySlider" Grid.Row="1" Margin="0,10,0,0"
                    Style="{StaticResource GammaSlider}"/>

            <!-- Кнопка вкл/выкл и шестерёнка -->
            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ToggleButton x:Name="PowerButton" Height="34" Content="Включить"
                              Style="{StaticResource PowerToggle}"/>
                <Button x:Name="GearButton" Grid.Column="1" Width="34" Height="34" Margin="8,0,0,0"
                        Content="&#xE713;" ToolTip="Настройки"
                        Style="{StaticResource IconButton}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
